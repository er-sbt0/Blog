{
  "name": "@blog/desktop",
  "private": true,
  "version": "0.0.0",
  "productName": "blog-desktop",
  "type": "module",
  "description": "Electron shell: an embedded Postgres cluster plus the Next standalone server, in one window.",
  "homepage": "https://blog.example",
  "desktopName": "blog-desktop.desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/build-agent-schema.mjs && electron .",
    "start:no-sandbox": "node scripts/build-agent-schema.mjs && electron . --no-sandbox",
    "dev": "node scripts/build-agent-schema.mjs && DESKTOP_DEV=1 electron .",
    "dev:no-sandbox": "node scripts/build-agent-schema.mjs && DESKTOP_DEV=1 electron . --no-sandbox",
    "rebuild:native": "electron-rebuild -f -w node-pty -m ../..",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:agent-schema": "node scripts/build-agent-schema.mjs",
    "stage:resources": "node scripts/stage-resources.mjs",
    "package": "node scripts/stage-resources.mjs && electron-builder --linux",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@anthropic-ai/sdk": "0.137.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "embedded-postgres": "17.10.0-beta.17",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
