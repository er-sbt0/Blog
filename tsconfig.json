{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/editor": [
        "./packages/editor/src"
      ],
      "@/editor/*": [
        "./packages/editor/src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@public/*": [
        "./public/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-desktop/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "temp/types/**/*.ts",
    ".next-desktop-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-desktop",
    ".next-desktop-dev",
    "tmp",
    "prisma/scripts/**",
    "packages/desktop/.stage",
    "packages/desktop/.dist"
  ]
}
